        <div class="titlebar drag-handle"><strong id="buddies-title">♟ Buddy List</strong><span class="title-actions"><button type="button" data-minimize="buddies" aria-label="Minimize Buddy List">_</button><button type="button" data-maximize="buddies" aria-label="Maximize Buddy List">□</button><button type="button" data-close="buddies" aria-label="Close Buddy List">×</button></span></div>
