      <section id="window-im" class="desktop-window classic-window im-window" data-window="im" aria-labelledby="im-title" hidden><div class="titlebar drag-handle"><strong id="im-title">☏ Instant Message</strong><span class="title-actions"><button type="button" data-minimize="im" aria-label="Minimize Instant Message">_</button><button type="button" data-maximize="im" aria-label="Maximize Instant Message">□</button><button type="button" data-close="im" aria-label="Close Instant Message">×</button></span></div><div class="window-content"><div id="im-contact" class="im-contact">Choose a buddy to start a conversation.</div><div id="im-messages" class="im-messages" role="log" aria-live="polite"></div><form id="im-form" class="chat-compose"><label for="im-input" class="visually-hidden">Instant message</label><input id="im-input" maxlength="450" placeholder="Type an instant message…" autocomplete="off"><button class="classic-button" type="submit">Send</button></form><div id="im-status" class="statusbar" role="status">Instant messages use your AOV account.</div></div></section>

      <section id="window-channels" class="desktop-window classic-window" data-window="channels" aria-labelledby="channels-title" hidden><div class="titlebar drag-handle"><strong id="channels-title">▦ AOV Channels</strong><span class="title-actions"><button type="button" data-minimize="channels" aria-label="Minimize Channels">_</button><button type="button" data-maximize="channels" aria-label="Maximize Channels">□</button><button type="button" data-close="channels" aria-label="Close Channels">×</button></span></div><div class="window-content channels-content"><div class="channels-layout"><div class="channels-left"><img class="channels-logo" src="assets/aov-logo.png" alt="AOV America OnVibe"><div class="channels-label">Channels</div><button type="button" class="channels-return" data-open="welcome">⌂ Return to Welcome</button><div id="channel-search" class="channels-search" aria-label="Search"></div><div id="channel-left" class="channel-column" aria-label="Featured channels"></div></div><div id="channel-grid" class="channels-columns" aria-label="Channels"><div id="channel-middle" class="channel-column"></div><div id="channel-right" class="channel-column"></div></div></div></div></section>

      <section id="window-channel-view" class="desktop-window classic-window" data-window="channel-view" aria-labelledby="channel-view-title" hidden><div class="titlebar drag-handle"><strong id="channel-view-title">▦ AOV Channel</strong><span class="title-actions"><button type="button" data-minimize="channel-view" aria-label="Minimize Channel">_</button><button type="button" data-maximize="channel-view" aria-label="Maximize Channel">□</button><button type="button" data-close="channel-view" aria-label="Close Channel">×</button></span></div><div class="window-content channel-view-content"><div class="channel-view-header"><img id="channel-view-logo" alt=""><div><h2 id="channel-view-heading"></h2><p id="channel-view-description"></p><button id="channel-parent" class="channel-parent" type="button" hidden>← Back</button></div><button id="channel-favorite-toggle" type="button" aria-label="Add channel to Favorites" aria-pressed="false" title="Add to Favorites">☆</button></div><div class="channel-view-layout"><nav id="channel-view-nav" class="channel-view-nav" aria-label="Channel navigation"></nav><div id="channel-view-body" class="channel-view-body"></div></div><div id="channel-view-status" class="statusbar" role="status">Choose a section.</div></div></section>

      <section id="window-favorites" class="desktop-window classic-window" data-window="favorites" aria-labelledby="favorites-title" hidden><div class="titlebar drag-handle"><strong id="favorites-title">★ My Favorites</strong><span class="title-actions"><button type="button" data-minimize="favorites" aria-label="Minimize Favorites">_</button><button type="button" data-maximize="favorites" aria-label="Maximize Favorites">□</button><button type="button" data-close="favorites" aria-label="Close Favorites">×</button></span></div><div class="window-content favorites-content"><div class="favorites-intro">Your saved AOV channels and subchannels</div><div id="channel-favorites-list" class="favorites-list" aria-label="Saved channels"></div><div id="favorites-status" class="statusbar" role="status">Choose a favorite to open it.</div></div></section>

      <section id="window-settings" class="desktop-window classic-window" data-window="settings" aria-labelledby="settings-title" hidden><div class="titlebar drag-handle"><strong id="settings-title">⚙ AOV Settings</strong><span class="title-actions"><button type="button" data-minimize="settings" aria-label="Minimize Settings">_</button><button type="button" data-maximize="settings" aria-label="Maximize Settings">□</button><button type="button" data-close="settings" aria-label="Close Settings">×</button></span></div><div class="window-content settings-content"><h2>Preferences</h2><p id="admin-link" hidden><a href="admin.php">Open AOV Administration</a></p><fieldset><legend>Account</legend><div class="account-summary">Signed on as <strong id="account-name"></strong> · Recovery email: <span id="account-email"></span></div><form id="change-zip-form" class="account-form"><label for="profile-zip">US ZIP code for local news and weather</label><input id="profile-zip" type="text" inputmode="numeric" pattern="[0-9]{5}" minlength="5" maxlength="5" required autocomplete="postal-code"><button class="classic-button" type="submit">Update ZIP Code</button></form><form id="change-name-form" class="account-form"><label for="profile-name">Screen name</label><input id="profile-name" maxlength="24" required><label for="profile-name-password">Current password</label><input id="profile-name-password" type="password" required autocomplete="current-password"><button class="classic-button" type="submit">Update Screen Name</button></form><form id="change-password-form" class="account-form"><label for="profile-current-password">Current password</label><input id="profile-current-password" type="password" required autocomplete="current-password"><label for="profile-new-password">New password</label><input id="profile-new-password" type="password" minlength="12" required autocomplete="new-password"><label for="profile-confirm-password">Confirm password</label><input id="profile-confirm-password" type="password" minlength="12" required autocomplete="new-password"><button class="classic-button" type="submit">Change Password</button></form><p id="profile-message" role="status" class="form-note form-message"></p></fieldset><fieldset><legend>Sounds</legend><label class="checkbox-label"><input id="sound-enabled" type="checkbox" checked> Play interface and connection sounds</label><label for="sound-volume">Volume <output id="volume-value">40%</output></label><input id="sound-volume" type="range" min="0" max="100" value="40"><button id="replay-connection" class="classic-button" type="button">Show Connection Screen</button></fieldset><fieldset><legend>Display</legend><label class="checkbox-label"><input id="reduced-motion" type="checkbox"> Reduce animations</label></fieldset><fieldset><legend>Browser home</legend><label for="home-url">Home page</label><input id="home-url" type="url" value="https://www.npr.org/sections/news/"><small>Leave empty to use AOV Home.</small></fieldset><p class="form-note">Sound and volume choices are saved in this browser. Reduced motion follows your device setting until changed for this page.</p></div></section>

      <section id="window-help" class="desktop-window classic-window" data-window="help" aria-labelledby="help-title" hidden><div class="titlebar drag-handle"><strong id="help-title">? About AOV</strong><span class="title-actions"><button type="button" data-close="help" aria-label="Close Help">×</button></span></div><div class="window-content help-content"><h2>About AOV</h2><p>AOV recreates the feel of a classic online service in your web browser. Account sign-on, chat, buddy lists, and internal mail are active.</p><p>AOV Mail only reaches other members; password recovery uses separate SMTP configuration. External website shortcuts may open in normal browser tabs.</p><p>AOV is independent and is not affiliated with AOL. Spoken interface clips are generated with <a href="https://elevenlabs.io/" target="_blank" rel="noopener noreferrer">ElevenLabs</a>.</p></div></section>
